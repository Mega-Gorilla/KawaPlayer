--- !u!114 &3425928189055123940
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8944412800055461809}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.6392157, g: 0.6509804, b: 0.6901961, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 6488e13b806b0524dbadc43e3a9bd5fb, type: 3}
    m_FontSize: 30
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.1
  m_Text: "\u66F4\u65B0\u5C65\u6B74:\n\nv1.2.1\nURL\_\u5165\u529B\u306E\u30AD\u30FC\u30DC\u30FC\u30C9\u3092\u30AD\u30E3\u30F3\u30BB\u30EB\u3067\u9589\u3058\u305F\u3068\u304D\u306B\u3001\u5165\u529B\u6B04\u306B\u6B8B\u3063\u3066\u3044\u305F\_URL\_\u304C\u518D\u9001\u4FE1\u3055\u308C\u308B\u554F\u984C\u3092\u4FEE\u6B63\n\u518D\u751F/\u30AD\u30E5\u30FC\u8FFD\u52A0\u306E\u78BA\u8A8D\u3092\u30AD\u30E3\u30F3\u30BB\u30EB\u3057\u305F\u3068\u304D\u306F\u3001\u5165\u529B\u6B04\u3092\u7A7A\u306B\u3059\u308B\u3088\u3046\u306B\n\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u4E00\u89A7\u3092\u8FFD\u52A0\u3057\u305F\u9806\u306B\u4E26\u3079\u308B\u3088\u3046\u306B\_(\u524A\u9664\u3057\u305F\u4F4D\u7F6E\u306B\u65B0\u3057\u3044\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u304C\u5165\u3089\u306A\u3044\u3088\u3046\u306B\u3002\u66F4\u65B0\u3057\u3066\u3082\u4F4D\u7F6E\u306F\u5909\u308F\u308A\u307E\u305B\u3093)\n\u30C7\u30D5\u30A9\u30EB\u30C8\_URL\_\u306B\_VHub\_\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u3092\u8A2D\u5B9A\u3059\u308B\u3068\u304D\u3082\u3001\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u306E\u8AAD\u307F\u8FBC\u307F\u5148\u304C\u4E00\u676F\u306A\u3089\u3001\u3069\u306E\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u304C\u6D88\u3048\u308B\u304B\u3092\u78BA\u8A8D\u3057\u3066\u304B\u3089\u5165\u308C\u66FF\u3048\u308B\u3088\u3046\u306B\n\nv1.2.0\nURL\_\u5165\u529B\u6B04\u3067\_VHub\_\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\_URL\_\u3092\u76F4\u63A5\u8AAD\u307F\u8FBC\u3081\u308B\u3088\u3046\u306B\u7D71\u5408\_(\u5C02\u7528\u306E\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u5165\u529B\u6B04\u306F\u5EC3\u6B62)\nVHub\_\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u306E\u8AAD\u307F\u8FBC\u307F\u5148\u3092\u30AD\u30E5\u30FC\u304B\u3089\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u306B\u5909\u66F4\_(\u518D\u751F\u3057\u3066\u3082\u6D88\u3048\u305A\u3001\u66F2\u3092\u9078\u3073\u76F4\u305B\u307E\u3059\u3002\u6700\u5F8C\u307E\u3067\u518D\u751F\u3059\u308B\u3068\u5148\u982D\u306B\u623B\u3063\u3066\u30EB\u30FC\u30D7\u3057\u307E\u3059)\n\u8AAD\u307F\u8FBC\u3093\u3060\_VHub\_\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u3092\u753B\u9762\u5185\u304B\u3089\u66F4\u65B0\u30FB\u524A\u9664\u3067\u304D\u308B\u3088\u3046\u306B\_(\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u540D\u306E\u6A2A\u306E\u30DC\u30BF\u30F3)\n\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u306E\u8AAD\u307F\u8FBC\u307F\u5148\_(\u6A19\u6E96\_5\_\u4EF6)\_\u304C\u4E00\u676F\u306E\u3068\u304D\u306F\u3001\u3069\u306E\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u304C\u6D88\u3048\u308B\u304B\u3092\u78BA\u8A8D\u3057\u3066\u304B\u3089\u5165\u308C\u66FF\u3048\u308B\u3088\u3046\u306B\n\u8AAD\u307F\u8FBC\u307F\u6E08\u307F\u306E\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u3092\u3082\u3046\u4E00\u5EA6\u8AAD\u307F\u8FBC\u3080\u3068\u3001\u8FFD\u52A0\u3067\u306F\u306A\u304F\u66F4\u65B0\u3068\u3057\u3066\u6271\u3044\u300C\u66F4\u65B0\u3057\u307E\u3057\u305F\u300D\u3068\u8868\u793A\n\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u3092\u524A\u9664\u3057\u305F\u3042\u3068\u306F\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u4E00\u89A7\u306B\u623B\u308B\u3088\u3046\u306B\nPlaylist\_Editor\_\u306B\_VHub\_\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u306E\u53D6\u308A\u8FBC\u307F\u6A5F\u80FD\u3092\u8FFD\u52A0\_(Unity\_\u4E0A\u3067\u5171\u6709\_URL\_\u3092\u8CBC\u308B\u3068\u56FA\u5B9A\u306E\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u3068\u3057\u3066\u30EF\u30FC\u30EB\u30C9\u306B\u713C\u304D\u8FBC\u307E\u308C\u307E\u3059\u3002\u53D6\u5F97\u5143\_URL\_\u3092\u4FDD\u5B58\u3059\u308B\u305F\u3081\u3001\u540C\u3058\_URL\_\u3067\u518D\u5EA6\u53D6\u308A\u8FBC\u3080\u3068\u5185\u5BB9\u3092\u66F4\u65B0\u3067\u304D\u307E\u3059)\n\u505C\u6B62\u4E2D\u306E\u753B\u9762\u4E0A\u90E8\u306B\u3001\u30D7\u30EC\u30A4\u30E4\u30FC\u540D\u30FB\u30D0\u30FC\u30B8\u30E7\u30F3\u3068\u5165\u529B\u6B04\u304C\u5BFE\u5FDC\u3059\u308B\_URL\_\u306E\u7A2E\u985E\u3092\u8868\u793A\n\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u8AAD\u307F\u8FBC\u307F\u306E\u7D50\u679C\_(\u8FFD\u52A0\u66F2\u6570\u30FB\u30A8\u30E9\u30FC\u5185\u5BB9)\_\u3092\u753B\u9762\u306B\u8868\u793A\u3059\u308B\u3088\u3046\u306B\u6539\u5584\n\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u8AAD\u307F\u8FBC\u307F\u304C\u518D\u751F\u6A29\u9650\_(Permission)\_\u306E\u5BFE\u8C61\u306B\u306A\u308A\u307E\u3057\u305F\n\u30C7\u30D5\u30A9\u30EB\u30C8\_URL\_\u306E\u8A2D\u5B9A\u6B04\u306F\u3001\u8A2D\u5B9A\u6A29\u9650\u304C\u7121\u3044\u3068\u304D\u306F\u975E\u8868\u793A\u306B\u3057\u3066\u7406\u7531\u3092\u6848\u5185\u3059\u308B\u3088\u3046\u306B\n\u78BA\u8A8D\u30C0\u30A4\u30A2\u30ED\u30B0\u3092\u6539\u5584\_(\u8868\u793A\u4E2D\u306E\u78BA\u8A8D\u304C\u5225\u306E\u64CD\u4F5C\u3067\u6D88\u3048\u306A\u3044\u3088\u3046\u306B\_/\_\u30D7\u30EC\u30A4\u30E4\u30FC\u9078\u629E\u3092\u6A2A\u4E26\u3073\u306B\u8868\u793A)\n\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u753B\u9762\u306E\u30DC\u30BF\u30F3\u306E\u5927\u304D\u3055\u3068\u3001\u65E5\u672C\u8A9E\u30FB\u4E2D\u56FD\u8A9E\u306E\u6587\u8A00\u306E\u6298\u308A\u8FD4\u3057\u3092\u8ABF\u6574\nYouTube\_\u52D5\u753B\u306E\u518D\u751F\u306B\u5931\u6557\u3057\u305F\u969B\u3001\u72B6\u6CC1\u306B\u5FDC\u3058\u305F\u88DC\u8DB3\u6848\u5185\u3092\u8868\u793A\u3059\u308B\u3088\u3046\u306B\u6539\u5584\nPlaylist\_Panel\_\u306E\u30BF\u30D6\_(\u30AD\u30E5\u30FC/\u5C65\u6B74/\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8)\_\u304C\u8868\u793A\u3055\u308C\u305A\u64CD\u4F5C\u3067\u304D\u306A\u3044\u554F\u984C\u3092\u4FEE\u6B63\n\u672C\u5BB6\_YamaPlayer\_\u306E\u66F4\u65B0\u3092\u53D6\u308A\u8FBC\u307F\_(2026-08-03\_\u6642\u70B9\u306E\u6700\u65B0\u306B\u8FFD\u5F93)\n-\_\u30A8\u30E9\u30FC\u767A\u751F\u6642\u306B\u505C\u6B62\u3067\u304D\u306A\u3044\u4E0D\u5177\u5408\u3092\u4FEE\u6B63\n-\_\u52D5\u753B\u5207\u66FF\u30FB\u30D5\u30A9\u30FC\u30EB\u30D0\u30C3\u30AF\u51E6\u7406\u306E\u5B89\u5B9A\u6027\u5411\u4E0A\n-\_\u4E00\u6642\u505C\u6B62\u4E2D\u306B\u52D5\u753B\u6E96\u5099\u304C\u5B8C\u4E86\u3057\u3066\u3082\u52DD\u624B\u306B\u518D\u751F\u3055\u308C\u306A\u3044\u3088\u3046\u4FEE\u6B63\_(TimelineSync)\n-\_\u30A8\u30C7\u30A3\u30BF\u306E\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u7DE8\u96C6\u753B\u9762\u306E\u4E0D\u5177\u5408\u3092\u4FEE\u6B63\n\nv1.1.2\n\u30C7\u30D5\u30A9\u30EB\u30C8\_URL\_\u6A5F\u80FD\u30929\u8A00\u8A9E\u5BFE\u5FDC\_(\u65E5\u672C\u8A9E/\u82F1\u8A9E/\u97D3\u56FD\u8A9E/\u4E2D\u56FD\u8A9E\u7C21\u4F53\u30FB\u7E41\u4F53/\u30B9\u30DA\u30A4\u30F3\u8A9E/\u30A4\u30BF\u30EA\u30A2\u8A9E/\u30ED\u30B7\u30A2\u8A9E/\u30A6\u30AF\u30E9\u30A4\u30CA\u8A9E)\n\u5165\u529B\u6B04\u306B\u73FE\u5728\u306E\u30C7\u30D5\u30A9\u30EB\u30C8\_URL\_\u3092\u81EA\u52D5\u8868\u793A\nUI\_\u30C7\u30B6\u30A4\u30F3\u3092\u6539\u5584\n\nv1.1.1\n\u5185\u90E8\u6539\u5584\u306E\u307F\_(\u5229\u7528\u65B9\u6CD5\u306F\u5909\u308F\u308A\u307E\u305B\u3093)\n\nv1.1.0\n\u30C7\u30D5\u30A9\u30EB\u30C8\_URL\_\u6A5F\u80FD\u3092\u8FFD\u52A0\n-\_Owner\_\u304C\u30EF\u30FC\u30EB\u30C9\u5165\u5BA4\u6642\u306B\u81EA\u52D5\u518D\u751F\u3055\u308C\u308B\_URL\_\u3092\_VRChat\_\u5185\u304B\u3089\u8A2D\u5B9A\u53EF\u80FD\n-\_\u8A2D\u5B9A\u3057\u305F\_URL\_\u306F\u6B21\u56DE\u5165\u5BA4\u6642\u306B\u3082\u81EA\u52D5\u5FA9\u5143\n-\_\u52D5\u753B\_URL\_/\_VHub\_\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\_URL\_\u306E\u4E21\u65B9\u306B\u5BFE\u5FDC\n\nv1.0.0\nKawaPlayer\_\u6B63\u5F0F\u30EA\u30EA\u30FC\u30B9\_(YamaPlayer\_\u30D9\u30FC\u30B9)\nVHub\_\u30D7\u30EC\u30A4\u30EA\u30B9\u30C8\u8AAD\u307F\u8FBC\u307F\u6A5F\u80FD\u3092\u642D\u8F09\n\u30B7\u30E3\u30C3\u30D5\u30EB\u518D\u751F\u306E\u4E0D\u5177\u5408\u3092\u4FEE\u6B63\n"
